              "isInner": false,
              "settings": {
                "html": "<div class=\"lh-filter-bar\" aria-label=\"Portfolio filters\"><button class=\"lh-filter-btn  is-active\" data-filter=\"all\">All</button><button class=\"lh-filter-btn\" data-filter=\"3d\">3D Model</button><button class=\"lh-filter-btn\" data-filter=\"ai\">AI Generated</button><button class=\"lh-filter-btn\" data-filter=\"branding\">Branding</button><button class=\"lh-filter-btn\" data-filter=\"cgi\">CGI</button><button class=\"lh-filter-btn\" data-filter=\"feature\">Feature</button><button class=\"lh-filter-btn\" data-filter=\"film\">Film</button><button class=\"lh-filter-btn\" data-filter=\"keyvisual\">Key Visuals</button><button class=\"lh-filter-btn\" data-filter=\"tvc\">TVC</button><button class=\"lh-filter-btn\" data-filter=\"web\">Web Design</button></div>\n<div class=\"lh-work-grid\">\n  <article class=\"lh-work-card\" data-categories=\"tvc\"><a href=\"#\"><div class=\"lh-work-media\"><img src=\"/wp-content/uploads/tvc-ovaltine.jpg\" alt=\"TVC Ovaltine 2015 Adaptation\" loading=\"lazy\"></div><div class=\"lh-work-info\"><div class=\"lh-tag-row\"><span class=\"lh-tag\">TVC</span></div><h3 class=\"lh-work-title\">TVC Ovaltine 2015 Adaptation</h3><p>Campaign adaptation with cinematic product treatment.</p></div></a></article>\n  <article class=\"lh-work-card\" data-categories=\"cgi feature\"><a href=\"#\"><div class=\"lh-work-media\"><img src=\"/wp-content/uploads/bt-studio-huda.jpg\" alt=\"BT Studio – CGI Huda Football\" loading=\"lazy\"></div><div class=\"lh-work-info\"><div class=\"lh-tag-row\"><span class=\"lh-tag\">CGI</span><span class=\"lh-tag\">Feature</span></div><h3 class=\"lh-work-title\">BT Studio – CGI Huda Football</h3><p>CGI beer-football visual system for energetic campaign assets.</p></div></a></article>\n  <article class=\"lh-work-card\" data-categories=\"ai branding\"><a href=\"#\"><div class=\"lh-work-media\"><img src=\"/wp-content/uploads/stride-beyond.jpg\" alt=\"Stride Beyond\" loading=\"lazy\"></div><div class=\"lh-work-info\"><div class=\"lh-tag-row\"><span class=\"lh-tag\">AI Generated</span><span class=\"lh-tag\">Branding</span></div><h3 class=\"lh-work-title\">Stride Beyond</h3><p>AI-led identity exploration for a futuristic visual language.</p></div></a></article>\n  <article class=\"lh-work-card\" data-categories=\"3d ai\"><a href=\"#\"><div class=\"lh-work-media\"><img src=\"/wp-content/uploads/cheers-to-victory.jpg\" alt=\"Cheers to Victory\" loading=\"lazy\"></div><div class=\"lh-work-info\"><div class=\"lh-tag-row\"><span class=\"lh-tag\">3D Model</span><span class=\"lh-tag\">AI Generated</span></div><h3 class=\"lh-work-title\">Cheers to Victory</h3><p>Victory-themed 3D/AI visual with energetic beer celebration mood.</p></div></a></article>\n  <article class=\"lh-work-card\" data-categories=\"3d keyvisual\"><a href=\"#\"><div class=\"lh-work-media\"><img src=\"/wp-content/uploads/afc-key-visual.jpg\" alt=\"AFC Key Visual\" loading=\"lazy\"></div><div class=\"lh-work-info\"><div class=\"lh-tag-row\"><span class=\"lh-tag\">3D Model</span><span class=\"lh-tag\">Key Visuals</span></div><h3 class=\"lh-work-title\">AFC Key Visual</h3><p>High-impact sports key visual direction and product composition.</p></div></a></article>\n  <article class=\"lh-work-card\" data-categories=\"3d keyvisual\"><a href=\"#\"><div class=\"lh-work-media\"><img src=\"/wp-content/uploads/twister-pack-visual.jpg\" alt=\"Twister Pack Visual\" loading=\"lazy\"></div><div class=\"lh-work-info\"><div class=\"lh-tag-row\"><span class=\"lh-tag\">3D Model</span><span class=\"lh-tag\">Key Visuals</span></div><h3 class=\"lh-work-title\">Twister Pack Visual</h3><p>Pack-focused 3D visual built for retail and campaign usage.</p></div></a></article>\n  <article class=\"lh-work-card\" data-categories=\"3d keyvisual\"><a href=\"#\"><div class=\"lh-work-media\"><img src=\"/wp-content/uploads/halida-tet-2022.jpg\" alt=\"Halida Tet 2022 Key Visual\" loading=\"lazy\"></div><div class=\"lh-work-info\"><div class=\"lh-tag-row\"><span class=\"lh-tag\">3D Model</span><span class=\"lh-tag\">Key Visuals</span></div><h3 class=\"lh-work-title\">Halida Tet 2022 Key Visual</h3><p>Seasonal Tet composition combining beer product and festive energy.</p></div></a></article>\n  <article class=\"lh-work-card\" data-categories=\"3d keyvisual\"><a href=\"#\"><div class=\"lh-work-media\"><img src=\"/wp-content/uploads/huda-beach-carnival.jpg\" alt=\"Huda Beach Carnival 2023\" loading=\"lazy\"></div><div class=\"lh-work-info\"><div class=\"lh-tag-row\"><span class=\"lh-tag\">3D Model</span><span class=\"lh-tag\">Key Visuals</span></div><h3 class=\"lh-work-title\">Huda Beach Carnival 2023</h3><p>Event visual with beach, summer, and brand-world atmosphere.</p></div></a></article>\n  <article class=\"lh-work-card\" data-categories=\"web\"><a href=\"#\"><div class=\"lh-work-media\"><img src=\"/wp-content/uploads/circuit.jpg\" alt=\"Circuit\" loading=\"lazy\"></div><div class=\"lh-work-info\"><div class=\"lh-tag-row\"><span class=\"lh-tag\">Web Design</span></div><h3 class=\"lh-work-title\">Circuit</h3><p>Visual interface direction for a modern digital product concept.</p></div></a></article>\n  <article class=\"lh-work-card\" data-categories=\"web\"><a href=\"#\"><div class=\"lh-work-media\"><img src=\"/wp-content/uploads/spectral.jpg\" alt=\"Spectral\" loading=\"lazy\"></div><div class=\"lh-work-info\"><div class=\"lh-tag-row\"><span class=\"lh-tag\">Web Design</span></div><h3 class=\"lh-work-title\">Spectral</h3><p>Editorial web concept with atmospheric motion and dark UI styling.</p></div></a></article>\n  <article class=\"lh-work-card\" data-categories=\"branding\"><a href=\"#\"><div class=\"lh-work-media\"><img src=\"/wp-content/uploads/nexora.jpg\" alt=\"Nexora\" loading=\"lazy\"></div><div class=\"lh-work-info\"><div class=\"lh-tag-row\"><span class=\"lh-tag\">Branding</span></div><h3 class=\"lh-work-title\">Nexora</h3><p>Brand system exploration with premium futuristic identity cues.</p></div></a></article>\n  <article class=\"lh-work-card\" data-categories=\"film\"><a href=\"#\"><div class=\"lh-work-media\"><img src=\"/wp-content/uploads/astralis.jpg\" alt=\"Astralis\" loading=\"lazy\"></div><div class=\"lh-work-info\"><div class=\"lh-tag-row\"><span class=\"lh-tag\">Film</span></div><h3 class=\"lh-work-title\">Astralis</h3><p>Film-inspired visual direction with atmospheric narrative framing.</p></div></a></article>\n  <article class=\"lh-work-card\" data-categories=\"branding cgi\"><a href=\"#\"><div class=\"lh-work-media\"><img src=\"/wp-content/uploads/bt-studio-beverage.jpg\" alt=\"BT Studio – CGI Beverage Demo\" loading=\"lazy\"></div><div class=\"lh-work-info\"><div class=\"lh-tag-row\"><span class=\"lh-tag\">Branding</span><span class=\"lh-tag\">CGI</span></div><h3 class=\"lh-work-title\">BT Studio – CGI Beverage Demo</h3><p>Product-led CGI beverage demo with polished advertising finish.</p></div></a></article>\n</div>\n<script>(function(){var btns=document.querySelectorAll('[data-filter]');var cards=document.querySelectorAll('[data-categories]');btns.forEach(function(b){b.addEventListener('click',function(){var f=b.dataset.filter;btns.forEach(function(x){x.classList.remove('is-active')});b.classList.add('is-active');cards.forEach(function(c){c.hidden=!(f==='all'||c.dataset.categories.includes(f));});});});})();</script>"
